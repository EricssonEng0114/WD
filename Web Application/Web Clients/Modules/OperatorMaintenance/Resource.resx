  <data name="stmtDeleteUser" xml:space="preserve">
    <value>DELETE FROM TBL_OPERATOR WHERE UST_UserID = @UserID</value>
  </data>
  <data name="stmtGetAllUser" xml:space="preserve">
    <value>SELECT CAST((ABS(CHECKSUM(NEWID())) % 1000000 + 1) as varchar(100)) as TMPID, UST_UserID ,UST_UserName ,UST_UserGroup ,UST_PwdChgLastDate ,UST_PwdChgDaysValid ,UST_PwdPos ,UST_Pwd_0 ,UST_Pwd_1 ,UST_Pwd_2 ,UST_Pwd_3 ,UST_Pwd_4 ,UST_Pwd_5 ,UST_PwdChgRetryCnt ,UST_Comments ,UST_ForcePwdChg ,UST_NoSession ,UST_Clients ,UST_LastLogin ,UST_Locked FROM TBL_OPERATOR WITH (NOLOCK)</value>
  </data>
  <data name="stmtGetAllUserTiedToAdmin" xml:space="preserve">
    <value>SELECT CAST((ABS(CHECKSUM(NEWID())) % 1000000 + 1) as varchar(100)) as TMPID,  UST_UserID ,UST_UserName ,UST_UserGroup ,UST_PwdChgLastDate ,UST_PwdChgDaysValid ,UST_PwdPos ,UST_Pwd_0 ,UST_Pwd_1 ,UST_Pwd_2 ,UST_Pwd_3 ,UST_Pwd_4 ,UST_Pwd_5 ,UST_PwdChgRetryCnt ,UST_Comments ,UST_ForcePwdChg ,UST_NoSession ,UST_Clients ,UST_LastLogin ,UST_Locked 
FROM TBL_OPERATOR WITH (NOLOCK)
WHERE UST_ForUnisys = 
(
SELECT UST_ForUnisys FROM TBL_OPERATOR (NOLOCK)
WHERE UST_UserID = @userID
)</value>
  </data>
  <data name="stmtGetClientInfoList" xml:space="preserve">
    <value>SELECT CLT_ClientCode ,CLT_ClientModule ,CLT_ClientName ,CLT_ClientAlias ,CLT_ClientDBName ,CLT_ClientDBServerName FROM TBL_CLIENTINFO(nolock)</value>
  </data>
  <data name="stmtGetClientInfoListExcUnisys" xml:space="preserve">
    <value>SELECT CLT_ClientCode ,CLT_ClientModule ,CLT_ClientName ,CLT_ClientAlias ,CLT_ClientDBName ,CLT_ClientDBServerName FROM TBL_CLIENTINFO(nolock)
WHERE CLT_ClientCode &lt;&gt; 'Unisys'</value>
  </data>
  <data name="stmtInsertUser" xml:space="preserve">
    <value>INSERT INTO TBL_OPERATOR 
(UST_UserID,UST_UserName,UST_UserGroup,UST_PwdChgDaysValid,UST_PwdPos,UST_Pwd_0, UST_Comments,
 UST_ForcePwdChg, UST_Clients,UST_NoSession,UST_Locked,UST_ForUnisys)
  VALUES (@UserID, @UserName, @UserGroup, 30, 0, @Password, @Comments,
   1, @Clients,0,0,@ForUnisys)</value>
  </data>
  <data name="stmtIsUsrLogin" xml:space="preserve">
    <value>Select UST_NoSession from TBL_OPERATOR with(nolock) where UST_UserID = @userID</value>
  </data>
  <data name="stmtUpdateOperPassword" xml:space="preserve">
    <value>UPDATE TBL_OPERATOR SET
 UST_Pwd_{0} = @Password, 
 UST_PwdPos = @PassPos, 
 UST_PwdChgLastDate = GETDATE(), 
UST_ForcePwdChg = 1 WHERE UST_UserID = @UserID</value>
  </data>
  <data name="stmtUpdateUser" xml:space="preserve">
    <value>IF((SELECT UST_Locked FROM TBL_OPERATOR WITH(NOLOCK) WHERE UST_UserID = @UserID) = 1 AND @IsLocked = 0)
BEGIN
UPDATE TBL_OPERATOR
    SET UST_LastLogin = GETDATE()
    WHERE UST_UserID = @UserID AND ISNULL(UST_LastLogin,'1900-01-01') &lt;&gt; '1900-01-01'
END

UPDATE TBL_OPERATOR SET UST_UserName = @UserName,UST_UserGroup = @UserGroup  ,UST_Comments = @Comment
   ,UST_Clients =@Clients ,UST_ForUnisys = @ForUnisys, UST_Locked = @IsLocked, UST_NoSession = @IsSession,
   UST_ForcePwdChg = @ForcedPwdChanged, UST_PwdChgRetryCnt = 0 
 WHERE UST_UserID = @UserID
</value>
  </data>
  <data name="stmtUsrExisted" xml:space="preserve">
    <value>SELECT COUNT(1) FROM TBL_OPERATOR (NOLOCK) WHERE UST_UserID = @UserID</value>
