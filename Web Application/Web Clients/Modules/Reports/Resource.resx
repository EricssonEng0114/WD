  <data name="stmtGetAccessAllBranch" xml:space="preserve">
    <value>select ACC_Group{0} from TBL_ACCESSLEVEL nolock where ACC_FunctionCode = 'ViewAllBranch'</value>
  </data>
  <data name="stmtGetAllReport" xml:space="preserve">
    <value>SELECT RPT_ReportCode, RPT_ReportDesc, RPT_ReportName, RPT_ReportSrc, RPT_ShowInMenu, RPT_AppCode,RPT_ClientCode FROM TBL_REPORT with (nolock) WHERE RPT_ShowInMenu = 1</value>
  </data>
  <data name="stmtGetAllReportByClient" xml:space="preserve">
    <value>SELECT RPT_ReportCode, RPT_ReportDesc, RPT_ReportName, RPT_ReportSrc, RPT_ShowInMenu, RPT_AppCode,RPT_ClientCode FROM TBL_REPORT with (nolock) WHERE RPT_ClientCode = @ClientCode and RPT_ShowInMenu = 1</value>
  </data>
  <data name="stmtGetAllReportWithCode" xml:space="preserve">
    <value>SELECT RPT_ReportCode, RPT_ReportDesc, RPT_ReportName, RPT_ReportSrc, RPT_ShowInMenu, RPT_AppCode,RPT_ClientCode FROM TBL_REPORT with (nolock) WHERE RPT_ReportCode = @ReportCode and RPT_ShowInMenu = 1</value>
  </data>
  <data name="stmtGetClientConnectionString" xml:space="preserve">
    <value>SELECT 'Data Source='+ LTRIM(RTRIM(CLT_ClientDBServerName)) + ';Initial Catalog='+ LTRIM(RTRIM(CLT_ClientDBName)) +';Integrated Security=True' as ConnString  FROM TBL_CLIENTINFO WITH(NOLOCK) where CLT_ClientCode =  @ClientCode</value>
  </data>
  <data name="stmtGetCRReportInfo" xml:space="preserve">
    <value>SELECT A.RPT_ReportCode,A.RPT_ReportDesc, A.RPT_ReportName, A.RPT_ReportSrc, A.RPT_ClientCode,isnull(B.CLT_ClientDBName,'') AS RPT_DBName, isnull(B.CLT_ClientDBServerName,'') AS RPT_ServerName, @@SERVERNAME AS RPT_WebServerName, 'UVRPSWeb' AS RPT_WebDBName, A.RPT_ReportType FROM TBL_REPORT A WITH (NOLOCK) LEFT JOIN TBL_CLIENTINFO B WITH (NOLOCK) ON (A.RPT_ClientCode = B.CLT_ClientCode) WHERE A.RPT_ReportCode = @ReportCode and A.RPT_ClientCode = @ClientCode</value>
  </data>
  <data name="stmtGetCurrencyCode" xml:space="preserve">
    <value>SELECT * FROM TBL_CURRENCYDEF WITH (NOLOCK)</value>
  </data>
  <data name="stmtGetENCUnreadable" xml:space="preserve">
    <value>SELECT	*
FROM	TBL_ITEM (NOLOCK)
INNER	JOIN TBL_BSTATUS (NOLOCK)
ON		ITM_BusDate = BST_BusDate
AND		ITM_WsID = BST_WsId
AND		ITM_BatchDirectory = BST_BatchDirectory
AND		ITM_BatchNum = BST_BatchNum
WHERE	ITM_ONUS = 1
AND		ITM_ItemType = 'S'
AND		(ISNUMERIC(ITM_Fld2) &lt;&gt; 1 OR ISNUMERIC(ITM_Fld4) &lt;&gt; 1 OR ISNUMERIC(ITM_Fld5) &lt;&gt; 1 OR ISNUMERIC(ITM_Fld3) &lt;&gt; 1)
AND		BST_BusDate = @Busdate</value>
  </data>
  <data name="stmtGetRequiredImgPrintRptList" xml:space="preserve">
    <value>SELECT PAR_ParamName, PAR_Value1,PAR_Value2,PAR_Comment FROM TBL_PARAM WITH (NOLOCK) WHERE PAR_ParamName IN ('ICPSReportIncludeImg','IRPSReportIncludeImg')</value>
  </data>
  <data name="RlpsIFS" xml:space="preserve">
    <value>RLPS_IFSPath</value>
  </data>
  <data name="stmtGetClientInfoList" xml:space="preserve">
    <value>SELECT CLT_ClientCode ,CLT_ClientModule ,CLT_ClientName ,CLT_ClientAlias ,CLT_ClientDBName ,CLT_ClientDBServerName FROM TBL_CLIENTINFO(nolock)</value>
  </data>
  <data name="stmtGetClientInfoListExcUnisys" xml:space="preserve">
    <value>SELECT CLT_ClientCode ,CLT_ClientModule ,CLT_ClientName ,CLT_ClientAlias ,CLT_ClientDBName ,CLT_ClientDBServerName FROM TBL_CLIENTINFO(nolock)
WHERE CLT_ClientCode &lt;&gt; 'Unisys'</value>
  </data>
