  <data name="sqlStmtGetResetItem" xml:space="preserve">
    <value>SELECT COUNT(1) FROM TBL_REJECTITEMSTATUS (Nolock) 
WHERE REJ_STATUS = 'W'
AND REJ_BUSDATE = @Busdate
AND REJ_BATCHNUM = @BatchNum
AND REJ_TRANSNUM = @TransNum</value>
  </data>
  <data name="sqlStmtGetSelectedRejTransactionList" xml:space="preserve">
    <value>SELECT  CASE WHEN A.REJ_REASON LIKE 'RL%' THEN 'RL' 
		WHEN A.REJ_REASON LIKE 'DI%' THEN 'DI' 
		WHEN A.REJ_REASON LIKE 'REJECT%' THEN 'PV' ELSE '' END AS REJ_CATEGORY, 
		 B.ITM_BatchDirectory, A.REJ_BUSDATE, A.REJ_BATCHNUM, A.REJ_TRANSNUM, A.REJ_REJECTBY,
A.REJ_REJECTTIME, A.REJ_SITECODE, A.REJ_REASON, A.REJ_ALLOWTOLERANCE,
A.REJ_ALLOWBREAKDOWN, A.REJ_STATUS, B.ITM_FLD9 AS ITM_Fld10,CASE WHEN (len(rtrim(ltrim(B.ITM_ProcMode))) &gt; 1 and B.ITM_ProcMode = '02') THEN 'M'
  WHEN (len(rtrim(ltrim(B.ITM_ProcMode))) &gt; 1 and B.ITM_ProcMode &lt;&gt; '02') THEN 'C'
  ELSE B.ITM_ProcMode END as PROC_MODE,
A.REJ_ACTIONEDBY, A.REJ_ACTIONEDTIME, A.REJ_DECISION, ISNULL(A.REJ_REMARK,'') AS REJ_REMARK, A.REJ_NEW_BUNDLEID    
 FROM TBL_REJECTITEMSTATUS A(NOLOCK)
INNER JOIN 
	(SELECT ITM_ProcMode, ITM_BatchDirectory, ITM_BusDate, ITM_BatchNum, ITM_TransNum, ITM_FLD9  
	FROM TBL_ITEM WITH (NOLOCK) WHERE ITM_ItemType = 'C' 
	GROUP BY  ITM_BusDate, ITM_BatchDirectory, ITM_BatchNum, ITM_TransNum,ITM_ProcMode, ITM_FLD9  
	) B ON (A.REJ_BUSDATE = B.ITM_BUSDATE AND A.REJ_BATCHNUM = B.ITM_BatchNum
	AND A.REJ_TRANSNUM = B.ITM_TransNum)  
WHERE REJ_BUSDATE = @Busdate
AND REJ_BATCHNUM = @BatchNo
AND REJ_TRANSNUM = @TransNo
AND REJ_NEW_BUNDLEID = @BundleId
AND REJ_SITECODE = @Site</value>
  </data>
  <data name="sqlStmtResetTransactionStatus" xml:space="preserve">
    <value>UPDATE TBL_REJECTITEMSTATUS
  SET REJ_STATUS= 'W',REJ_ACTIONEDBY = '', REJ_ACTIONEDTIME = NULL
  WHERE REJ_BUSDATE = @CurBusDate and REJ_BATCHNUM = @BatchNum 
  AND REJ_TRANSNUM = @TransNo  AND LTRIM(RTRIM(REJ_ACTIONEDBY)) = @OperID AND REJ_STATUS = 'I'</value>
  </data>
  <data name="stmtGetREJLatestStatus" xml:space="preserve">
    <value>SELECT LTRIM(RTRIM(ISNULL(REJ_STATUS,''))) AS REJ_STATUS 
 FROM TBL_REJECTITEMSTATUS(NOLOCK)
WHERE REJ_BUSDATE = @Busdate
AND REJ_BATCHNUM = @BatchNum 
AND REJ_TRANSNUM = @TransNo
AND REJ_NEW_BUNDLEID = @BundleID</value>
  </data>
  <data name="stmtResetTransUponLogout" xml:space="preserve">
    <value>UPDATE TBL_REJECTITEMSTATUS  
SET REJ_STATUS = 'W', REJ_ACTIONEDBY= '',
REJ_ACTIONEDTIME = NULL
WHERE REJ_ACTIONEDBY = @OperID 
AND REJ_STATUS = 'I'</value>
