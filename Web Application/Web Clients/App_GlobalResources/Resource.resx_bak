  <data name="cstrLastLoginValidityPeriod" xml:space="preserve">
    <value>LastLoginValidityPeriod</value>
  </data>
  <data name="cstrMAXLOGONTRY" xml:space="preserve">
    <value>MaxLogonAttempt</value>
  </data>
  <data name="MsgInactiveAccountLocked" xml:space="preserve">
    <value>Your last login date is &gt; 90 days. Account has been locked for security purposes. Please contact System Administrator to unlock account.</value>
  </data>
  <data name="MsgInvalidUserID" xml:space="preserve">
    <value>Invalid Login ID and/or Password entered.</value>
  </data>
  <data name="MsgMaxLogonTry" xml:space="preserve">
    <value>User ID has been lockout. Please contact your System Administrator.</value>
  </data>
  <data name="MsgPasswordChanged" xml:space="preserve">
    <value>You have successfully changed password. Please login with the new password. </value>
  </data>
  <data name="MsgPasswordExpired" xml:space="preserve">
    <value>Your password has already expired. 
Please change your password.</value>
  </data>
  <data name="MsgPasswordForceChg" xml:space="preserve">
    <value>You must change your password in order to proceed. </value>
  </data>
  <data name="MsgPasswordInvalid" xml:space="preserve">
    <value>Error: The password and password confirmation that you have entered is different. Please re-enter the password before proceed.</value>
  </data>
  <data name="stmtGetUserInfo" xml:space="preserve">
    <value>SELECT UST_UserID ,UST_UserName ,UST_UserGroup ,UST_PwdChgLastDate ,UST_PwdChgDaysValid ,UST_PwdPos ,UST_Pwd_0 ,UST_Pwd_1 ,UST_Pwd_2 ,UST_Pwd_3 ,UST_Pwd_4 ,UST_Pwd_5 ,UST_PwdChgRetryCnt ,UST_Comments ,UST_ForcePwdChg ,UST_NoSession, UST_Clients,UST_LastLogin,UST_Locked,UST_ForUnisys  FROM TBL_OPERATOR WITH (NOLOCK) WHERE UST_UserID = @UserID</value>
  </data>
  <data name="cstrMaxLogonSession" xml:space="preserve">
    <value>MaxLogonSession</value>
  </data>
  <data name="MsgMaxLogonSession" xml:space="preserve">
    <value>Duplicate Login detected / You have not logout properly previously. Please contact Administrator to reset.</value>
  </data>
  <data name="UpdateLastLogin" xml:space="preserve">
    <value>UPDATE TBL_OPERATOR SET UST_PwdChgRetryCnt = @Count, UST_LastLogin = GETDATE(), UST_Locked = CASE WHEN UST_Locked = 2 THEN 0 ELSE UST_Locked END WHERE UST_UserID = @UserID</value>
  </data>
  <data name="UpdateLockedAccount" xml:space="preserve">
    <value>UPDATE TBL_OPERATOR SET UST_Locked = @Locked WHERE UST_UserID = @UserID</value>
  </data>
  <data name="MsgAllPasswordRequired" xml:space="preserve">
    <value>Error: All Password fields are required. </value>
  </data>
  <data name="stmtGetUserLogin" xml:space="preserve">
    <value>SELECT * FROM TBL_OPERATOR WHERE UST_UserID = @UserID</value>
  </data>
  <data name="cstrMinPasswordLength" xml:space="preserve">
    <value>MinPasswordLength</value>
  </data>
  <data name="MsgUserChangedPassword" xml:space="preserve">
    <value>You have successfully changed password. Kindly proceed to login.</value>
  </data>
  <data name="MsgUserChangedPasswordLog" xml:space="preserve">
    <value>User ID: {0} has successfully changed password.</value>
  </data>
  <data name="UpdateUserPassword" xml:space="preserve">
    <value>UPDATE TBL_OPERATOR SET
 UST_Pwd_{0} = @Password, 
 UST_PwdPos = @PassPos, 
 UST_PwdChgLastDate = GETDATE(), 
UST_ForcePwdChg = 0 WHERE UST_UserID = @UserID</value>
  </data>
  <data name="UpdateUserSession" xml:space="preserve">
    <value>UPDATE TBL_OPERATOR SET UST_NoSession = @UserSession WHERE UST_UserID = @UserID</value>
  </data>
  <data name="cstrCutOffTime" xml:space="preserve">
    <value>WEBDEC_CUTOFFTIME</value>
  </data>
  <data name="MainSiteParam" xml:space="preserve">
    <value>MainSite</value>
  </data>
  <data name="cstrResetInterval" xml:space="preserve">
    <value>ResetWeb_IntervalTime</value>
  </data>
  <data name="MsgSessionExpired" xml:space="preserve">
    <value>Your session has already expired. Please login to proceed.</value>
  </data>
